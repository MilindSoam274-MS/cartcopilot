# =========================
# Assistant Service
# =========================
RETRIEVAL_BASE_URL=http://127.0.0.1:8001
LLM_PROVIDER=grok

# =========================
# Shared Database (Python services)
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cartcopilot
DB_USER=cartcopilot
DB_PASSWORD=cartcopilot

# =========================
# Checkout Service
# =========================
REDIS_URL=redis://localhost:6379/0
CHECKOUT_TTL_SECONDS=3600
ORDER_TTL_SECONDS=604800

# =========================
# Catalog Service
# =========================
PHASE1_MODE=true

# =========================
# Index Service
# =========================
# Used by index-service while writing FAISS artifacts
INDEX_DIR=./indexes

# =========================
# Retrieval Service
# =========================
MENU_ITEMS_TABLE=phase1_menu_items
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
INDEX_VERSION=20260204_0625
TOP_K=80
RETURN_K=5
MIN_TOP1_SCORE=0.45
MIN_TOP1_MINUS_TOP2=0.02

# NOTE:
# retrieval-service currently expects INDEX_DIR too,
# but with a different default path than index-service.
# Keep that service-specific override in its local .env if needed.
# Example for retrieval-service local run:
# INDEX_DIR=../index-service/indexes

# =========================
# Infrastructure
# =========================
POSTGRES_USER=cartcopilot
POSTGRES_PASSWORD=cartcopilot
POSTGRES_DB=cartcopilot

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin